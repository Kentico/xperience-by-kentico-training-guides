@using TrainingGuides.Web.Features.ResponsiveImages

@model ImageVariantsShowcaseViewModel

@if (Model.Image is { } image)
{
    <section class="mt-4">
        <h2 class="h4">Primitives: art direction</h2>
        <picture>
            <source media="(max-width: 575.98px)" kxp-img="@image.Asset" kxp-img-variant="@ImageVariants.HERO_MOBILE_828X828" kxp-img-dimensions="true" />
            <img kxp-img="@image.Asset" kxp-img-variant="@ImageVariants.HERO_WIDE_1920X1080" kxp-img-dimensions="true"
                alt="@image.AltText" loading="eager" class="img-fluid" />
        </picture>
    </section>

    <section class="mt-4">
        <h2 class="h4">Primitives: fixed card crop</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 c-blog-grid">
            <div class="col">
                <div class="c-post-thumbnail default">
                    <div class="c-card bg-1 u-border-01">
                        <div class="c-card_img">
                            <img kxp-img="@image.Asset" kxp-img-variant="@ImageVariants.CARD_800X600" kxp-img-dimensions="true"
                                alt="@image.AltText" loading="lazy" class="img-fluid" />
                        </div>
                        <div class="c-card_body">
                            <h3 class="h4 mb-0">@Model.Title</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mt-4">
        <h2 class="h4">Building block: responsive image</h2>
        <tg-responsive-image asset="@image.Asset" alt="@image.AltText" sizes="100vw" class="img-fluid" />
    </section>
}
