{
  "mcpServers": {
    "xperience-management-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@kentico/management-api-mcp@latest"
      ],
      "env": {
        "MANAGEMENT_API_URL": "https://localhost:53415/kentico-api/management",
        "MANAGEMENT_API_SECRET": "${MANAGEMENT_API_SECRET}",
        "NODE_OPTIONS": "--use-system-ca"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
